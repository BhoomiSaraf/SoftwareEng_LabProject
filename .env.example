# =============================================================================
# Smart Attendance System - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in appropriate values before starting.
# Never commit real secrets or production credentials to version control.

# Application Environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# Session Secret Key
# Required in production. Generate a strong random key, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Secure Session Cookies
# Set to 'true' in production when running behind HTTPS/TLS reverse proxy.
SESSION_COOKIE_SECURE=false

# Session Lifetime in seconds (default: 3600 = 1 hour)
PERMANENT_SESSION_LIFETIME=3600

# Optional custom SQLite Database Path (defaults to smart_attendance.db in workspace root)
# DB_PATH=smart_attendance.db

# Optional Camera API Key for external hardware scanner kiosks
# CAMERA_API_KEY=your-hardware-scanner-api-key

# Configurable Biometric Face Embeddings Path
# EMBEDDINGS_FILE=data/embeddings.npz

# Face Recognition Matching Threshold (0.0 to 1.0, default: 0.65)
# RECOGNITION_THRESHOLD=0.65

# Academic Course Configuration Defaults
# DEFAULT_COURSE_CREDITS=3
# DEFAULT_COURSE_SEMESTER=5
# DEFAULT_ACADEMIC_YEAR=2026-2027

# Flask Debug Mode (strictly disabled in production)
FLASK_DEBUG=false

